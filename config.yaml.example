# MIDI SysEx Preset Manager — configuration
#
# Copy this file to ~/.midi-sx-presets/config.yaml (or pass --config-dir)
# to customise the service.

# Name of the virtual MIDI port created by the service.
# Used only in standalone mode (when 'routing' is not configured).
# Connect your DAW / MainStage to this port.
port_name: MIDI SX Presets

# SysEx device ID (0x00–0x7F). Change this if you run multiple instances.
device_id: 0x01

# SysEx manufacturer ID. 0x7D = non-commercial / educational.
manufacturer_id: 0x7D

# --- MIDI Routing (proxy mode) -----------------------------------------------
#
# When configured, the service acts as a transparent MIDI proxy between
# MainStage and your hardware MIDI interface:
#
#   MainStage Scripter  →  iac_input  →  [service]  →  hardware_output
#                                            ↕
#                          iac_return  ←  [service]   (preset recall data)
#
# All non-preset traffic is forwarded transparently to hardware_output.
# SysEx preset commands are intercepted and handled by the service.
# Preset recall data is sent back to MainStage via iac_return.
#
# Uncomment and set the port names to match your system.
# Use --list-ports to see available MIDI port names.
#
# routing:
#   iac_input: "IAC Driver Bus 1"
#   iac_return: "IAC Driver Bus 2"
#   hardware_output: "Your MIDI Interface"

# --- Recall Ignore ---------------------------------------------------------------
#
# Parameters listed here are saved normally but skipped during preset
# recall, keeping their current live value.  Useful for global controls
# like master volume that shouldn't jump when switching presets.
#
# Entries can be a destination parameter name (string) or an explicit
# channel/cc pair (channel is 1-based):
#
# recall_ignore:
#   - ns_to_perf_filter
#   - {channel: 1, cc: 7}

# --- Bank Tags ------------------------------------------------------------------
#
# Controls which parameters are included when saving/recalling presets
# in each bank (channel).  Tags are assigned to parameters in cc_sets.yaml
# (group-level or per-entry) and in destinations.yaml (per-channel overrides).
#
# Parameters with no explicit tags get the implicit "default" tag.
# Banks not listed here default to ["default"] — only untagged parameters.
#
# bank_tags:
#   1: [default, synth, mix]         # ch1 bank saves/recalls these tags
#   2: [default, synth, performance] # ch2 bank saves/recalls these tags

# --- Persistent State -----------------------------------------------------------
#
# The service periodically saves all destination values, the current
# preset cursor, and mode flags to state.yaml so it can recover
# seamlessly after a crash or restart.  Defaults are only used for
# parameters not yet seen in the state file.
#
# Interval in seconds between state dumps (0 to disable).
# state_save_interval: 5
