# Destination Map (optional)
#
# Each top-level key is a destination identifier.  Reserved keys inside
# a destination:
#   prefix    - prepended to inherited CC names (e.g. "ns" → "ns_pan")
#   channels  - dict of MIDI channels (0–15), each containing:
#     cc_group  - inherit a named set from cc_sets.yaml
#     prefix    - override the destination prefix for this channel
#     <int>     - bare integer keys are CC overrides (not prefixed),
#                 can shadow an inherited name
#
# Conflict detection: if two different (channel, CC) pairs resolve to the
# same name within one destination, a warning is logged at startup.
#
# Per-channel override entries (dict form) can also carry ``tags`` that
# merge with the tags inherited from the cc_group:
#
#     85: {name: perf_out, default: 63, tags: [performance]}

# Example (uncomment and customise for your setup):
#
# nerdseq:
#   prefix: ns
#   channels:
#     0:
#       cc_group: mix_ccs
#     1:
#       cc_group: polysynth_ccs
#       85: nerdseq_perf_out
#     2:
#       cc_group: mix_ccs
#       prefix: ns_fx
#
# bluebox:
#   prefix: bb
#   channels:
#     2:
#       cc_group: mix_ccs
